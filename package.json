// package.json - For Capacitor Android build setup
{
  "name": "dstudio-android-ide",
  "version": "2.0.0",
  "description": "Android Smart IDE Studio",
  "main": "index.html",
  "scripts": {
    "build": "echo 'web assets ready'",
    "capacitor:add": "npx cap add android",
    "capacitor:sync": "npx cap sync android",
    "capacitor:open": "npx cap open android",
    "android:build": "npm run capacitor:sync && npx cap copy android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/filesystem": "^5.0.0",
    "@capacitor/splash-screen": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0"
  }
}
